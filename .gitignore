# 构建产物
/dist/
/build/
*.spec
/installer/*.exe
/installer/*.pfx
/installer/omnibrowser.ico

# package/ 下混有构建脚本与产物：只排除产物，保留 build_debs.sh（Linux 侧构建入口）
/package/*
!/package/build_debs.sh

# WorkBuddy 本地数据（非项目内容）
/.workbuddy/
/.Trash-0/
/memory/

# 中间文件
/core/target/
/_stage/
/__pycache__/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 运行时数据
*.omnidl

# 操作系统
Thumbs.db
.DS_Store
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp
